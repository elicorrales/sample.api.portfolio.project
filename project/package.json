{
  "name": "users-admin-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scarfSettings": {
    "enabled": false
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node api/src/server.ts",
    "dev": "JWT_SECRET=dev-only-secret-not-for-production-use node scripts/dev.ts",
    "dev:demo": "JWT_SECRET=dev-only-secret-not-for-production-use DEMO_MODE=true MAX_USERS=200 node scripts/dev.ts",
    "token": "JWT_SECRET=dev-only-secret-not-for-production-use node scripts/dev-token.ts",
    "test": "vitest run",
    "test:bad-calls": "vitest run tests/bad-calls",
    "test:happy-path": "vitest run tests/happy-path tests/workflow",
    "test:security": "vitest run tests/security",
    "test:rate-limit": "vitest run tests/rate-limit",
    "test:integrity": "vitest run tests/integrity",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:spec": "npx --yes @redocly/cli@2.52.1 lint api/openapi.yaml",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "swagger-ui-dist": "5.32.15",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
